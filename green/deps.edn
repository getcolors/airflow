{:paths ["src/clj" "src/resources"]
 ;; Pinned by sha so this project resolves as a git dependency elsewhere — the
 ;; launcher fetches it that way. Temporarily use a local-root coordinate when
 ;; developing several checkouts together, or set GREEN_LIB_ROOT / ONCE_LIB_ROOT.
 ;;
 ;; `once` is a dependency on a *package*, not on the SDK, and it is much wider
 ;; here than in walter: this package uses the provider registry as data, the
 ;; compute templates as classpath resources, AND three step functions —
 ;; tofu-smtp-step, tofu-dns-step and tofu-smtp-post-step — as a code-level API.
 ;; Nothing upstream protects any of it. See plans/0001-airflow-v1.md and
 ;; scripts/golden.sh, which is what actually catches a breaking change.
 ;;
 ;; Both pins match walter's deliberately: two packages resolving the same
 ;; upstream means a golden diff in one is evidence about the other.
 :deps    {org.clojure/clojure       {:mvn/version "1.12.5"}
           io.github.getcolors/green {:git/url "https://github.com/getcolors/green.git"
                                      :git/sha "ceb4159a19ec281d60f10d11295c05c5de5f1c42"}
           io.github.getcolors/once  {:git/url "https://github.com/getcolors/once.git"
                                      :git/sha "98d3cfa2c743b89a72bac0252c258f9edeedcad7"
                                      :deps/root "green"}}
 :aliases {:dev  {:extra-paths ["test/clj" "test/resources"]}
           :test {:extra-paths ["test/clj" "test/resources"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}}}
