{
  "output": {
    "params": {
      "value": {
        "ip": "${hcloud_server.node.ipv4_address}",
        "name": "${hcloud_server.node.name}",
        "node_id": "0",
        "provider": "hcloud",
        "provider_id": "${hcloud_server.node.id}",
        "server_id": "${hcloud_server.node.id}",
        "ssh_key_id": "fixture-key",
        "sudoer": "root",
        "user": "root",
        "vpc_ip": null
      }
    }
  },
  "provider": {
    "hcloud": {}
  },
  "resource": {
    "hcloud_server": {
      "node": {
        "firewall_ids": [
          23456
        ],
        "image": "ubuntu-24.04",
        "labels": {
          "colors-profile": "airflow-fixture"
        },
        "lifecycle": {
          "prevent_destroy": true
        },
        "location": "hel1",
        "name": "airflow-fixture",
        "public_net": {
          "ipv4_enabled": true,
          "ipv6_enabled": false
        },
        "server_type": "cx23",
        "ssh_keys": [
          "fixture-key"
        ]
      }
    }
  },
  "terraform": {
    "required_providers": {
      "hcloud": {
        "source": "hetznercloud/hcloud",
        "version": "1.54.0"
      }
    }
  }
}
