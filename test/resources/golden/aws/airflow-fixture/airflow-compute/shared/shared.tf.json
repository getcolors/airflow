{
  "output": {
    "params": {
      "value": {
        "network_cidr": "${aws_vpc.network.cidr_block}",
        "provider": "aws",
        "security_group_id": "${aws_security_group.network.id}",
        "subnet_id": "${aws_subnet.public.id}",
        "vpc_id": "${aws_vpc.network.id}"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "eu-west-1"
    }
  },
  "resource": {
    "aws_internet_gateway": {
      "gateway": {
        "tags": {
          "Name": "airflow"
        },
        "vpc_id": "${aws_vpc.network.id}"
      }
    },
    "aws_route": {
      "internet": {
        "destination_cidr_block": "0.0.0.0/0",
        "gateway_id": "${aws_internet_gateway.gateway.id}",
        "route_table_id": "${aws_route_table.public.id}"
      }
    },
    "aws_route_table": {
      "public": {
        "tags": {
          "Name": "airflow"
        },
        "vpc_id": "${aws_vpc.network.id}"
      }
    },
    "aws_route_table_association": {
      "public": {
        "route_table_id": "${aws_route_table.public.id}",
        "subnet_id": "${aws_subnet.public.id}"
      }
    },
    "aws_security_group": {
      "network": {
        "description": "Deployment node access",
        "name": "airflow-fixture-firewall",
        "tags": {
          "Name": "airflow-fixture-firewall"
        },
        "vpc_id": "${aws_vpc.network.id}"
      }
    },
    "aws_subnet": {
      "public": {
        "availability_zone": "eu-west-1a",
        "cidr_block": "10.0.1.0/24",
        "map_public_ip_on_launch": true,
        "tags": {
          "Name": "airflow"
        },
        "vpc_id": "${aws_vpc.network.id}"
      }
    },
    "aws_vpc": {
      "network": {
        "cidr_block": "10.0.0.0/16",
        "enable_dns_hostnames": true,
        "enable_dns_support": true,
        "tags": {
          "Name": "airflow"
        }
      }
    },
    "aws_vpc_security_group_egress_rule": {
      "egress": {
        "cidr_ipv4": "${each.value.cidr}",
        "for_each": {
          "all-ipv4": {
            "cidr": "0.0.0.0/0",
            "from_port": null,
            "protocol": "-1",
            "to_port": null
          }
        },
        "from_port": "${each.value.from_port}",
        "ip_protocol": "${each.value.protocol}",
        "security_group_id": "${aws_security_group.network.id}",
        "to_port": "${each.value.to_port}"
      }
    },
    "aws_vpc_security_group_ingress_rule": {
      "ingress": {
        "cidr_ipv4": "${each.value.cidr}",
        "for_each": {
          "http:0.0.0.0/0": {
            "cidr": "0.0.0.0/0",
            "from_port": 80,
            "protocol": "tcp",
            "to_port": 80
          },
          "https:0.0.0.0/0": {
            "cidr": "0.0.0.0/0",
            "from_port": 443,
            "protocol": "tcp",
            "to_port": 443
          },
          "ssh:0.0.0.0/0": {
            "cidr": "0.0.0.0/0",
            "from_port": 22,
            "protocol": "tcp",
            "to_port": 22
          }
        },
        "from_port": "${each.value.from_port}",
        "ip_protocol": "${each.value.protocol}",
        "security_group_id": "${aws_security_group.network.id}",
        "to_port": "${each.value.to_port}"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "6.31.0"
      }
    },
    "required_version": ">= 1.8.0"
  }
}
